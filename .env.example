# Copie para .env e preencha. Nunca versione o .env (RNF07).
# Variáveis vazias usam o padrão do PRD; as marcadas com (obrigatória) impedem o start se faltarem.

# --- Evolution API (seção 10) ---
# (obrigatória)
EVOLUTION_BASE_URL=https://evolution.ricardo.home.nom.br
# (obrigatória) nome puro; o client codifica na URL
EVOLUTION_INSTANCE=ao vivo vv
# (obrigatória, segredo)
EVOLUTION_API_KEY=
EVOLUTION_TIMEOUT_MS=10000
EVOLUTION_MAX_RETRIES=3

# --- Servidor e webhook (RNF04, RNF08) ---
HOST=0.0.0.0
PORT=3000
# https://<seu-dominio> (usado no setWebhook)
PUBLIC_BASE_URL=
# (obrigatória, segredo) 32+ caracteres [A-Za-z0-9_-]
WEBHOOK_TOKEN=
WEBHOOK_RATE_LIMIT_PER_S=30
WEBHOOK_BODY_LIMIT_BYTES=1048576
HEALTH_CHECK_INTERVAL_S=30

# --- Painel e alertas (RNF09, 6.3) ---
# (obrigatória, segredo) 12+ caracteres
ADMIN_PASSWORD=
# (obrigatória) E.164 sem "+", ex.: 5527999887766
ADMIN_PHONE=

# --- Dados e logs (RNF02, RNF05) ---
DATA_DIR=./data
TEMPLATES_DIR=./templates
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# --- Campanha ---
LOJA_NOME=LIVE! Vila Velha
# Último dia da campanha (AAAA-MM-DD); aparece no texto como "31/10 (sábado)"
CAMPANHA_DATA_FIM=

# --- Modo de operação (RF07, RF20) ---
# CAMPANHA_ATIVA=false: o serviço não envia nada (chave geral)
CAMPANHA_ATIVA=false
# DRY_RUN=true: o worker só simula (horários e textos no log), sem chamar a API
DRY_RUN=true
# lista separada por vírgula
TEST_ALLOWLIST=
USE_BUTTONS=false
MARK_READ=true

# --- Cadência (6.1) ---
# Intervalo mínimo entre dois envios (segundos)
JITTER_MIN_S=120
JITTER_MAX_S=300
BREAK_EVERY_MIN=8
BREAK_EVERY_MAX=15
BREAK_MIN_MIN=10
BREAK_MAX_MIN=25
TYPING_MIN_MS=3000
TYPING_MAX_MS=6000
TYPING_CHARS_PER_S=40
REPLY_TYPING_MIN_MS=1500
REPLY_TYPING_MAX_MS=2000

# --- Janela de horário, fuso America/Sao_Paulo (6.1, RNF12) ---
WINDOW_WEEKDAY_START=09:00
WINDOW_WEEKDAY_END=20:00
WINDOW_SATURDAY_START=09:00
WINDOW_SATURDAY_END=20:00
WINDOW_SUNDAY=false
# AAAA-MM-DD separados por vírgula
HOLIDAYS=

# --- Volume (6.1) ---
# Trava diária: no máximo X convites por dia, espaçados entre o início e o fim da janela
DAILY_LIMIT=40
# Rampa de aquecimento (dia 1, 2, 3, 4+). Vale o menor entre a rampa e DAILY_LIMIT.
# Para usar sempre X, coloque DAILY_RAMP igual a DAILY_LIMIT.
DAILY_RAMP=40,60,80,100
HOURLY_CAP=20
# SEGMENTO | IMPORTACAO
SEND_ORDER=SEGMENTO

# --- Tentativas (seção 8) ---
MAX_ATTEMPTS=3
RETRY_AFTER_MIN=60

# --- Disjuntores (6.2) ---
BREAKER_CONSECUTIVE_FAILURES=3
BREAKER_CONSECUTIVE_PAUSE_MIN=30
BREAKER_ERROR_RATE=0.10
BREAKER_ERROR_WINDOW=30
BREAKER_OPTOUT_RATE=0.08
BREAKER_OPTOUT_WINDOW=50
BREAKER_HEALTH_FAILURES=2
