{
  "name": "campanha-whatsapp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "discover": "tsx scripts/discover.ts",
    "capture-webhook": "tsx scripts/capture-webhook.ts",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/empacotar-windows.ps1",
    "cli": "tsx src/cli/index.ts",
    "importar": "tsx src/cli/index.ts importar",
    "simular": "tsx src/cli/index.ts simular",
    "teste-envio": "tsx src/cli/index.ts teste-envio"
  },
  "dependencies": {
    "better-sqlite3": "12.8.0",
    "fastify": "^5.12.7",
    "luxon": "^3.7.2",
    "pdfjs-dist": "^4.10.38",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@12.8.0": true,
    "esbuild@0.28.2": true
  },
  "//better-sqlite3": "Fixado em 12.8.0: Ãºltima versÃ£o com binÃ¡rio pronto para Node 20 (ABI 115). A 12.10+ sÃ³ tem para Node 22+."
}
